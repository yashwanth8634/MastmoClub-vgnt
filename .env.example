#----------------------------------------------------------------------
# Environment Variables Example
#
# This file contains a list of all environment variables required by the
# application. Copy this file to .env.local and fill in the values for
# your local development environment. For production, these variables
# should be set in your deployment platform's dashboard (e.g., Vercel).
#----------------------------------------------------------------------

# -- Database --
# Your MongoDB connection string.
MONGODB_URI=mongodb+srv://user:password@host/mastmoclub

# -- Email Configuration (Gmail SMTP) --
# Email address to send emails from
GMAIL_USER=your-email@gmail.com
# App-specific password from Google Account (16 characters, no spaces)
GMAIL_APP_PASSWORD=your-16-character-app-password

# -- Logging --
# The log level for the application. Can be 'debug', 'info', 'warn', 'error'.
# Defaults to 'info' if not set. Set to 'debug' for more verbose logging.
LOG_LEVEL=info



# -- Application --
NODE_ENV=production
APP_VERSION=1.0.0
JWT_SECRET=

